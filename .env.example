# Copy this file to a new file named ".env" (in the same folder) and fill in the values.

# XAMPP MySQL connection.
# Format: mysql://USER:PASSWORD@localhost:3306/DATABASE_NAME
# Replace YourStrongPassword with the root password you set in the XAMPP Shell.
# The database "personal_hub" is created automatically on the first migrate.
DATABASE_URL="mysql://root:YourStrongPassword@localhost:3306/personal_hub"

# Secret used to sign your login session. Must be at least 32 characters.
# Generate one in the VS Code terminal with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# then paste the result here.
AUTH_SECRET="paste-the-generated-secret-here"

# Key used to encrypt document numbers and uploaded files (Records).
# Generate one the same way as AUTH_SECRET (64 characters) and paste it here.
# IMPORTANT: keep a copy somewhere safe (e.g. written down). If this key is
# lost or changed, saved document numbers and files can't be opened again.
ENCRYPTION_KEY="paste-another-generated-secret-here"

# Leave as false while you open the Hub over http (laptop and Tailscale).
COOKIE_SECURE="false"
